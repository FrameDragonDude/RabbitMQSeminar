    {
      "name": "7. Theo dõi thời gian thực (SSE)",
      "description": "Mở request này ở một tab riêng: Postman hiển thị luồng sự kiện liên tục trong lúc chạy các kịch bản khác (Postman bản mới hỗ trợ Server-Sent Events).",
      "item": [
        {
          "name": "Luồng sự kiện",
          "event": [],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/monitor/events"
          }
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Hiển thị kết quả dạng bảng ở tab \"Visualize\" của Postman (3 màu: tím chàm, xám, đỏ)",
          "const STYLE = '<style>body{font-family:Segoe UI,system-ui,sans-serif;color:#1e293b;padding:6px;font-size:13px}'",
          "  + '.head{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin-bottom:12px}'",
          "  + '.pill{padding:3px 10px;border-radius:999px;font-weight:700;background:#eef2ff;color:#4f46e5}'",
          "  + '.pill.bad{background:#fef2f2;color:#dc2626}.muted{color:#64748b}'",
          "  + 'table{border-collapse:collapse;width:100%}td,th{padding:7px 8px;border-bottom:1px solid #e2e8f0;text-align:left;vertical-align:top}'",
          "  + 'th{color:#64748b;font-size:11px;text-transform:uppercase;letter-spacing:.05em}'",
          "  + 'tr.bad td{color:#dc2626}.mono{font-family:Consolas,monospace}.num{text-align:right;font-weight:700}'",
          "  + '.bar{height:8px;border-radius:4px;background:#4f46e5;min-width:2px}.bar.bad{background:#dc2626}</style>';",
          "",
          "const url = pm.request.url.toString();",
          "const BAD = ['FAILED', 'DEAD_LETTERED', 'INVALID_MESSAGE', 'CONSUMER_STOPPED'];",
          "",
          "if (pm.response.code === 200 && url.includes('/api/tracking/')) {",
          "  const data = pm.response.json();",
          "  pm.visualizer.set(STYLE + `",
          "    <div class=\"head\"><b class=\"mono\">{{reference}}</b>",
          "      <span class=\"pill {{#if bad}}bad{{/if}}\">{{status}}</span><span class=\"muted\">{{summary}}</span></div>",
          "    <table><tr><th>Thời gian</th><th>Sự kiện</th><th>Nguồn</th><th>Chi tiết</th></tr>",
          "    {{#each events}}<tr class=\"{{#if bad}}bad{{/if}}\"><td class=\"mono\">{{time}}</td><td><b>{{type}}</b></td>",
          "      <td>{{source}}</td><td>{{message}}</td></tr>{{/each}}</table>`, {",
          "    ...data,",
          "    bad: data.status === 'DEAD_LETTERED',",
          "    events: data.events.map(e => ({ ...e, bad: BAD.includes(e.type) })),",
          "  });",
          "}",
          "",
          "if (pm.response.code === 200 && url.includes('/api/monitor/stats')) {",
          "  const data = pm.response.json();",
          "  const max = Math.max(1, ...data.queues.map(q => q.ready));",
          "  pm.visualizer.set(STYLE + `",
          "    <div class=\"head\"><span class=\"pill {{#unless consumerRunning}}bad{{/unless}}\">",
          "      Consumer: {{#if consumerRunning}}đang chạy{{else}}đã dừng{{/if}}</span>",
          "      <span class=\"muted\">Đã xử lý <b>{{processedOrders}}</b> đơn · Chặn <b>{{duplicateSkipped}}</b> tin trùng</span></div>",
          "    <table><tr><th>Exchange</th><th>Routing key</th><th>Queue</th><th class=\"num\">Ready</th><th style=\"width:30%\"></th><th class=\"num\">Consumers</th></tr>",
          "    {{#each queues}}<tr class=\"{{#if dlq}}bad{{/if}}\"><td class=\"mono\">{{exchange}}</td><td class=\"mono\">{{routingKey}}</td>",
          "      <td class=\"mono\"><b>{{queue}}</b></td><td class=\"num\">{{ready}}</td>",
          "      <td><div class=\"bar {{#if dlq}}bad{{/if}}\" style=\"width:{{width}}%\"></div></td><td class=\"num\">{{consumers}}</td></tr>{{/each}}",
          "    </table>`, {",
          "    ...data,",
          "    queues: data.queues.map(q => ({ ...q, routingKey: q.routingKey || '—', dlq: q.queue === 'order.dlq', width: Math.round(q.ready / max * 100) })),",
          "  });",
          "}",
          "",
          "if (pm.response.code === 200 && url.endsWith('/get')) {",
          "  const messages = pm.response.json().map(m => {",
          "    const death = (m.properties.headers || {})['x-death'] || [];",
          "    return {",
          "      id: m.properties.message_id || '(không có)',",
          "      payload: m.payload,",
          "      reason: death.length ? death[0].reason : '—',",
          "      from: death.length ? death[0].queue + ' via ' + death[0].exchange : '—',",
          "    };",
          "  });",
          "  pm.visualizer.set(STYLE + `",
          "    <div class=\"head\"><b>Tin đang nằm trong queue</b><span class=\"pill bad\">{{messages.length}} tin</span>",
          "      <span class=\"muted\">đọc với ackmode=ack_requeue_true nên tin vẫn còn trong queue</span></div>",
          "    <table><tr><th>message_id</th><th>x-death reason</th><th>Queue gốc</th><th>Payload</th></tr>",
          "    {{#each messages}}<tr><td class=\"mono\"><b>{{id}}</b></td><td>{{reason}}</td><td class=\"mono\">{{from}}</td>",
          "      <td class=\"mono\">{{payload}}</td></tr>{{/each}}</table>`, { messages });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "rabbitUrl",
      "value": "http://localhost:15672/api"
    },
    {
      "key": "vhost",
      "value": "%2F"
    },
    {
      "key": "rabbitUser",
      "value": "seminar"
    },
    {
      "key": "rabbitPass",
      "value": "seminar123"
    },
    {
      "key": "orderCode",
      "value": ""
    },
